{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSparkS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::vueladata-datalake-dev-239700238526-us-east-1-an",
        "arn:aws:s3:::vueladata-datalake-dev-239700238526-us-east-1-an/*"
      ]
    },
    {
      "Sid": "AllowCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}
