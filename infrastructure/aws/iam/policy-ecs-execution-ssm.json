{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:${AWS_DEFAULT_REGION}:${AWS_ACCOUNT_ID}:parameter/vueladata/dev/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "${SSM_KMS_KEY_ARN}",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.${AWS_DEFAULT_REGION}.amazonaws.com"
        }
      }
    }
  ]
}
