{
  "family": "vueladata-spark-etl",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/vueladata-spark-task-role",
  "containerDefinitions": [
    {
      "name": "spark-etl",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/vueladata/spark-etl:latest",
      "essential": true,
      "environment": [
        {
          "name": "SPARK_DRIVER_MEMORY",
          "value": "3g"
        },
        {
          "name": "SPARK_SHUFFLE_PARTITIONS",
          "value": "64"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "${AWS_DEFAULT_REGION}"
        },
        {
          "name": "F6_TIMEZONE",
          "value": "UTC"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vueladata-spark-etl",
          "awslogs-region": "${AWS_DEFAULT_REGION}",
          "awslogs-stream-prefix": "spark-spot",
          "awslogs-create-group": "true"
        }
      },
      "secrets": [
        {
          "name": "S3_DATA_LAKE_BUCKET",
          "valueFrom": "/vueladata/dev/s3/bucket_name"
        },
        {
          "name": "RDS_HOST",
          "valueFrom": "/vueladata/dev/database/host"
        },
        {
          "name": "RDS_USER",
          "valueFrom": "/vueladata/dev/database/user"
        },
        {
          "name": "RDS_PASSWORD",
          "valueFrom": "/vueladata/dev/database/password"
        },
        {
          "name": "RDS_DB",
          "valueFrom": "/vueladata/dev/database/name"
        }
      ]
    }
  ]
}
