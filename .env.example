AIRFLOW_JWT_SECRET=vueladata_jwt_secret_change_in_production_315
AIRFLOW_API_SECRET_KEY=vueladata_api_secret_key_change_in_production_315

# Usuario Administrador
AIRFLOW_ADMIN_USERNAME=admin
