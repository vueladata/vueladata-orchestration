# ==============================================================================
# VARIABLES DE ENTORNO MAESTRAS - VUELA DATA ORCHESTRATION (Local & AWS)
# Según VuelaData lista maestra.md
# ==============================================================================

# ── Imagen personalizada de Airflow 3.x ───────────────────────────────────────
AIRFLOW_IMAGE_NAME=vueladata/airflow:3.1.5

# ── PostgreSQL (Base de datos compartida para VuelaData y Airflow) ────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vueladata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Conexión SQLAlchemy para Airflow (apunta a la base de datos 'airflow_db')
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/airflow_db
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://postgres:postgres@postgres:5432/airflow_db

# ── RabbitMQ Broker Celery y Workers ──────────────────────────────────────────
RABBITMQ_USER=rabbit_admin
RABBITMQ_PASSWORD=VuelaData_Rabbit2026!
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
AIRFLOW__CELERY__BROKER_URL=amqp://rabbit_admin:VuelaData_Rabbit2026!@rabbitmq:5672//

# Colas operacionales VuelaData
QUEUE_RDS=q.rds_writer
QUEUE_LAKE=q.lake_writer
QUEUE_NAME=eventos_oooi_queue

# ── Seguridad y Criptografía de Airflow 3.1.5 ─────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=dkoSW-HnalABxFeXIgKL4b0-SmnDocwv5cxBXjmj36Y=
AIRFLOW_JWT_SECRET=vueladata_jwt_secret_dev_2026
AIRFLOW_API_SECRET_KEY=vueladata_api_secret_key_dev_2026

# Administrador de Airflow UI
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin_local_2026

# ── Parámetros AWS Cloud (ECS, S3, Data Lake) ─────────────────────────────────
AWS_ACCOUNT_ID=239700238526
AWS_DEFAULT_REGION=us-east-1
S3_DATA_LAKE_BUCKET=vueladata-datalake-bronze
ECS_CLUSTER_NAME=vueladata-cluster
