# ==============================================================================
# VARIABLES DE ENTORNO MAESTRAS - VUELA DATA ORCHESTRATION (Local & AWS)
# Según VuelaData lista maestra.md
# ==============================================================================

# ── Imagen personalizada de Airflow 3.x ───────────────────────────────────────
AIRFLOW_IMAGE_NAME=vueladata/airflow:3.1.5

# ── PostgreSQL (Base de datos compartida para VuelaData y Airflow) ────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=vueladata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Conexión SQLAlchemy para Airflow (apunta a la base de datos 'airflow_db')
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=  # Optional; Compose builds the local URL from POSTGRES/RABBITMQ variables.
# AIRFLOW__CELERY__RESULT_BACKEND=  # Optional; Compose builds the local URL from POSTGRES/RABBITMQ variables.

# ── RabbitMQ Broker Celery y Workers ──────────────────────────────────────────
RABBITMQ_USER=rabbit_admin
RABBITMQ_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# AIRFLOW__CELERY__BROKER_URL=  # Optional; Compose builds the local URL from POSTGRES/RABBITMQ variables.

# Colas operacionales VuelaData
QUEUE_RDS=q.rds_writer
QUEUE_LAKE=q.lake_writer
QUEUE_NAME=eventos_oooi_queue

# ── Seguridad y Criptografía de Airflow 3.1.5 ─────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=

# Administrador de Airflow UI
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=

# ── Parámetros AWS Cloud (ECS, S3, Data Lake) ─────────────────────────────────
AWS_ACCOUNT_ID=
AWS_DEFAULT_REGION=us-east-1
S3_DATA_LAKE_BUCKET=vueladata-datalake-bronze
ECS_CLUSTER_NAME=vueladata-cluster

# ── Notificaciones por Correo (Worker Notificaciones, Gmail SMTP) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=tu_cuenta@gmail.com
SMTP_CLAVE=
SMTP_REMITENTE=tu_cuenta@gmail.com
# Modo pruebas: si tiene correo, TODOS los correos van aquí sin molestar a los del seed
EMAIL_DESTINO_PRUEBAS=tu_cuenta@gmail.com

ECS_SUBNET_IDS=[]
ECS_SECURITY_GROUP_IDS=[]
ECS_SPARK_TASK_DEFINITION=vueladata-spark-etl
ECS_SPARK_CONTAINER_NAME=spark-etl
LAMBDA_OPENSKY_NAME=opensky-ingestor
LAMBDA_OPENMETEO_NAME=openmeteo-ingestor
